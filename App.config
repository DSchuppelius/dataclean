<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="DataClean.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
        </sectionGroup>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="DataClean.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1"/>
    </startup>
    <applicationSettings>
        <DataClean.Properties.Settings>
            <setting name="cleanDirectories" serializeAs="String">
                <value>%TEMP%;%INTERNET_CACHE%;%HISTORY%;%WINDOWS_TEMP%;%PREFETCH%;%SOFTWARE_DISTRIBUTION%;%CRASH_DUMPS%;%THUMBNAIL_CACHE%;%EDGE_CACHE%;%CHROME_CACHE%;%FIREFOX_CACHE%;C:\Temp</value>
            </setting>
            <setting name="protectedDirectories" serializeAs="String">
                <value>%WINDOWS%;%SYSTEM%;%PROGRAM_FILES%;%PROGRAM_FILES_X86%;%USERPROFILE%</value>
            </setting>
            <setting name="allowedSubdirectories" serializeAs="String">
                <value>%TEMP%;%INTERNET_CACHE%;%HISTORY%;%WINDOWS_TEMP%;%PREFETCH%;%SOFTWARE_DISTRIBUTION%;%CRASH_DUMPS%;%THUMBNAIL_CACHE%;%EDGE_CACHE%;%CHROME_CACHE%;%FIREFOX_CACHE%</value>
            </setting>
            <setting name="emptyTrash" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="minFileAgeDays" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="removeWindowsOld" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="flushDnsCache" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="clearEventLogs" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="healthCheckEnabled" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="minFreeDiskPercent" serializeAs="String">
                <value>5</value>
            </setting>
            <setting name="notifyByTray" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="notifyByEmail" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="smtpHost" serializeAs="String">
                <value></value>
            </setting>
            <setting name="smtpPort" serializeAs="String">
                <value>25</value>
            </setting>
            <setting name="smtpEnableSsl" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="notifyFromAddress" serializeAs="String">
                <value></value>
            </setting>
            <setting name="notifyToAddress" serializeAs="String">
                <value>support@schuppelius.org</value>
            </setting>
        </DataClean.Properties.Settings>
    </applicationSettings>
    <userSettings>
        <DataClean.Properties.Settings>
            <setting name="dryRun" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="createRestorePoint" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="deleteToRecycleBin" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="cleanBrowserCaches" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="dismComponentCleanup" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="cleanMinidumps" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="cleanPrefetch" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="cleanDeliveryOptimization" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="cleanOldLogs" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="oldLogAgeDays" serializeAs="String">
                <value>30</value>
            </setting>
            <setting name="emptyAllRecycleBins" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="generateReport" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="reportPath" serializeAs="String">
                <value />
            </setting>
            <setting name="reportFormat" serializeAs="String">
                <value>HTML</value>
            </setting>
            <setting name="emailReport" serializeAs="String">
                <value>False</value>
            </setting>
        </DataClean.Properties.Settings>
    </userSettings>
</configuration>
