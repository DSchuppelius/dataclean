<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="DataClean.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="cleanDirectories" Type="System.String" Scope="Application">
      <Value Profile="(Default)">%TEMP%;%INTERNET_CACHE%;%HISTORY%;%WINDOWS_TEMP%;%PREFETCH%;%SOFTWARE_DISTRIBUTION%;%CRASH_DUMPS%;%THUMBNAIL_CACHE%;%EDGE_CACHE%;%CHROME_CACHE%;%FIREFOX_CACHE%;C:\Temp</Value>
    </Setting>
    <Setting Name="protectedDirectories" Type="System.String" Scope="Application">
      <Value Profile="(Default)">%WINDOWS%;%SYSTEM%;%PROGRAM_FILES%;%PROGRAM_FILES_X86%;%USERPROFILE%</Value>
    </Setting>
    <Setting Name="allowedSubdirectories" Type="System.String" Scope="Application">
      <Value Profile="(Default)">%TEMP%;%INTERNET_CACHE%;%HISTORY%;%WINDOWS_TEMP%;%PREFETCH%;%SOFTWARE_DISTRIBUTION%;%CRASH_DUMPS%;%THUMBNAIL_CACHE%;%EDGE_CACHE%;%CHROME_CACHE%;%FIREFOX_CACHE%</Value>
    </Setting>
    <Setting Name="emptyTrash" Type="System.Boolean" Scope="Application">
      <Value Profile="(Default)">True</Value>
    </Setting>
    <Setting Name="minFileAgeDays" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">0</Value>
    </Setting>
    <Setting Name="removeWindowsOld" Type="System.Boolean" Scope="Application">
      <Value Profile="(Default)">False</Value>
    </Setting>
